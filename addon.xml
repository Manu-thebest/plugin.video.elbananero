<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.elbananero" name="El Bananero" version="1.0.2" provider-name="Manu">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es">Todo el contenido de ElBananero.com</summary>
        <description lang="es">Lista y reproduce los videos de elbananero.com: novedades, las 11 categorias y busqueda. Los videos son MP4 directos, sin publicidad ni intermediarios.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/icon_bananero.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
